# DEX Development Secrets — Example
#
# Copy this file to ops/dev-secrets.env and fill in real values.
# This file is .gitignored and never committed.
#
# Usage:
#   source ops/dev-secrets.env
#   cd apps/web-ui && npm run dev

# ---- API tokens ----
export VITE_WS_TOKEN="your-local-dev-ws-token"
export VITE_AUTH_TOKEN="your-local-dev-auth-token"

# ---- External services (if applicable) ----
# export VITE_API_BASE_URL="http://localhost:3001/v1"
# export VITE_WS_URL="ws://localhost:8080/v1/ws"

# ---- Telemetry (point to local mock) ----
export VITE_TELEMETRY_ENDPOINT="http://localhost:9090/telemetry"
export VITE_TELEMETRY_SAMPLE_RATE="1.0"
export VITE_TELEMETRY_ENABLED="true"

# ---- Observability ----
export VITE_DEV_MODE="true"
export VITE_DEBUG_PANEL="true"
export VITE_METRICS_ENABLED="true"
