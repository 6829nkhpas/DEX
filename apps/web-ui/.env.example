# DEX Web UI — Environment Variables
#
# Copy this file to `.env` in the apps/web-ui/ directory.
# Vite reads VITE_* prefixed variables at build time.
#
# NEVER commit secrets to source control.

# ---- API ----
VITE_API_BASE_URL=/v1
VITE_WS_URL=ws://localhost:8080/v1/ws

# ---- Auth ----
# In production, obtain tokens from your identity provider.
# These are placeholder values for local development ONLY.
VITE_WS_TOKEN=your-ws-token-here
VITE_AUTH_TOKEN=your-auth-token-here

# ---- Telemetry ----
VITE_TELEMETRY_ENDPOINT=/telemetry
VITE_TELEMETRY_SAMPLE_RATE=0.01
VITE_TELEMETRY_ENABLED=true

# ---- Circuit Breaker ----
VITE_CB_FAILURE_THRESHOLD=5
VITE_CB_COOLDOWN_MS=30000

# ---- Rate Limiter ----
VITE_RL_CAPACITY=10
VITE_RL_REFILL_RATE=2

# ---- Feature Flags ----
VITE_DEV_MODE=true
VITE_DEBUG_PANEL=true
VITE_METRICS_ENABLED=true
