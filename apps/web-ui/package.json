{
  "name": "@dex/web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "DEX Web UI — API and WebSocket client layers",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/__tests__/*.test.ts'",
    "dev:mock": "tsx tools/mock-ws-server.ts --port 8080 --symbols BTC/USDT,ETH/USDT,SOL/USDT",
    "perf:publish": "tsx tools/ws-publisher.ts --rate 500 --symbols BTC/USDT --duration 60",
    "perf:bench": "tsx perf/bench-runner.ts --rate 100 --duration 60",
    "perf:matrix": "tsx perf/stress-matrix.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vite": "^7.3.1",
    "ws": "^8.19.0"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "wouter": "^3.9.0"
  }
}